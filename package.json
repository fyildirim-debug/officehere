{
  "name": "officehere",
  "private": true,
  "version": "0.1.0",
  "description": "Açık kaynak ofis paketi: Belge, Tablo ve Sunum",
  "license": "MIT",
  "author": "Furkan YILDIRIM <posta@furkanyildirim.com>",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:belge": "pnpm --filter @officehere/belge dev",
    "dev:tablo": "pnpm --filter @officehere/tablo dev",
    "dev:sunum": "pnpm --filter @officehere/sunum dev",
    "build": "pnpm -r --filter ./apps/* --filter ./packages/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
