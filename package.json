{
  "name": "officehere",
  "private": true,
  "version": "0.2.0-beta.2",
  "description": "Açık kaynak ofis paketi: Belge, Tablo ve Sunum",
  "license": "MIT",
  "author": "Furkan YILDIRIM <posta@furkanyildirim.com>",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:belge": "pnpm --filter @officehere/belge dev",
    "dev:tablo": "pnpm --filter @officehere/tablo dev",
    "dev:sunum": "pnpm --filter @officehere/sunum dev",
    "build": "pnpm -r --filter ./apps/belge --filter ./apps/tablo --filter ./apps/sunum --filter ./apps/desktop run build",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e/tsconfig.json",
    "test": "pnpm -r run test",
    "test:kapsam": "pnpm -r run test --testTimeout=60000 --coverage.enabled --coverage.include=src/** --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=text-summary && node scripts/kapsam.mjs",
    "test:perf": "pnpm --filter @officehere/tablo test:perf",
    "test:betikler": "node --test scripts/derlem/temel.test.mjs",
    "dev:desktop": "pnpm --filter @officehere/desktop dev",
    "dist:win": "pnpm --filter @officehere/desktop dist --win",
    "dist:linux": "pnpm --filter @officehere/desktop dist --linux",
    "dist:mac": "pnpm --filter @officehere/desktop dist --mac",
    "web": "node scripts/build-web.mjs",
    "e2e": "playwright test",
    "e2e:masaustu": "playwright test -c playwright.masaustu.config.ts",
    "gorsel": "node e2e/gorsel/calistir.mjs",
    "gorsel:guncelle": "node e2e/gorsel/calistir.mjs --guncelle",
    "denetim": "node scripts/denetim/yerel-ayar.mjs",
    "derlem": "node scripts/derlem/tur.mjs",
    "derlem:uret": "node scripts/derlem/uret.mjs",
    "derlem:lo": "node scripts/derlem/lo.mjs",
    "derlem:opc": "node scripts/derlem/opc.mjs",
    "derlem:xsd": "python3 scripts/derlem/xsd.py",
    "derlem:fark": "node scripts/derlem/xlsx_fark.mjs",
    "derlem:temel": "node scripts/derlem/temel.mjs --calistir",
    "derlem:pdfa": "node scripts/derlem/verapdf.mjs",
    "bulanik": "node scripts/bulanik/calistir.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
