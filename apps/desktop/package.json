{
  "name": "@officehere/desktop",
  "productName": "OfficeHere",
  "version": "0.1.6",
  "private": true,
  "description": "OfficeHere masaüstü uygulaması: Belge, Tablo ve Sunum",
  "license": "MIT",
  "author": "Furkan YILDIRIM <posta@furkanyildirim.com>",
  "homepage": "https://github.com/fyildirim-debug/officehere",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:launcher && pnpm run build:electron",
    "build:launcher": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "dist": "node scripts/dist.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@fluentui/react-icons": "^2.0.344",
    "@officehere/core": "workspace:*",
    "@officehere/ui": "workspace:*",
    "@types/node": "^26.6.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
